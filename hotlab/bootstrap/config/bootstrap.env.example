# Hot Lab bootstrap input contract. The PROVISION layer (GCP, Proxmox, libvirt,
# bare metal, anything) delivers this file to /etc/hotlab/bootstrap.env (mode 0600,
# root-owned) before bootstrap.sh runs. The guest never asks a metadata server.
# Shell syntax: KEY=value, no spaces around '='.

# ---- REQUIRED when HOTLAB_ENABLE_OPS=1 -------------------------------------
# Digest-pinned k3s image for the ops cluster (labapp discipline: image@sha256:...).
HOTLAB_MGMT_IMAGE=REPLACE_ME
# Helm chart versions. Exact versions only; no ranges, no "latest".
HOTLAB_ARGOCD_CHART_VERSION=REPLACE_ME
HOTLAB_GITEA_CHART_VERSION=REPLACE_ME

# ---- REQUIRED only when using cloud-init/user-data.yaml (git-based delivery) -
# HOTLAB_BOOTSTRAP_REPO=https://github.com/afewell-hh/hh-learn.git
# HOTLAB_BOOTSTRAP_REF=<40-hex commit SHA>

# ---- OPTIONAL (defaults shown) ----------------------------------------------
# Address the k3d load balancer publishes ops ports on. 127.0.0.1 = reach via SSH
# tunnel / the workspace tier (#505). 0.0.0.0 only if the provision layer firewalls.
HOTLAB_BIND_ADDRESS=127.0.0.1
HOTLAB_STATE_DIR=/var/lib/hotlab
HOTLAB_VLAB_USER=hotlab
HOTLAB_VLAB_DIR=/var/lib/hotlab/vlab
HOTLAB_K3D_CLUSTER=hotlab-mgmt
# Pinned hhfab (0.43.1 pins are in lib/pins.sh). 0.50.4 is NOT pinned here.
HOTLAB_HHFAB_VERSION=0.43.1
# UNVERIFIED flag sets, passed verbatim to hhfab. See README "Open items".
HOTLAB_HHFAB_INIT_ARGS="--dev --gateway=false"
HOTLAB_VLAB_GEN_ARGS=""
HOTLAB_VLAB_UP_ARGS="--kill-stale"
# Number of QEMU VMs verify.sh must see (e.g. 7 for 4 switches + control + 2 servers).
HOTLAB_EXPECT_VMS=0
# Stage toggles, so the ops stack and VLAB can be exercised independently.
HOTLAB_ENABLE_OPS=1
HOTLAB_ENABLE_VLAB=1
# Optional exact Docker apt version string (apt-cache madison docker.io). Empty = distro current, recorded not pinned.
HOTLAB_DOCKER_APT_VERSION=
