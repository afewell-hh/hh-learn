# Hot Lab bootstrap input contract. The PROVISION layer (GCP, Proxmox, libvirt,
# bare metal, anything) delivers this file to /etc/hotlab/bootstrap.env (mode 0600,
# root-owned: bootstrap.sh refuses anything else) before bootstrap.sh runs. The guest
# never asks a metadata server. Shell syntax: KEY=value, no spaces around '='.
# Every REPLACE_ME below aborts the run in preflight, before anything is installed.
# Booleans accept 1/0, true/false, yes/no, on/off; anything else is an error.

# ---- REQUIRED when HOTLAB_ENABLE_OPS=1 -------------------------------------
# Digest-pinned k3s image for the ops cluster (labapp discipline: image@sha256:...).
HOTLAB_MGMT_IMAGE=REPLACE_ME
# Helm chart versions. Exact versions only; no ranges, no "latest".
HOTLAB_ARGOCD_CHART_VERSION=REPLACE_ME
HOTLAB_GITEA_CHART_VERSION=REPLACE_ME

# ---- REQUIRED when HOTLAB_ENABLE_VLAB=1 (no defaults: fail closed) -----------
# Arguments for `hhfab init`, INCLUDING the credentials for the fabric (admin password
# hash / authorized keys). There is intentionally NO default. Discover the exact flag names
# for the pinned version with `hhfab init --help` (U: not verified here).
HOTLAB_HHFAB_INIT_ARGS=REPLACE_ME
# `--dev` (public upstream development credentials) is REFUSED unless you also set this to 1.
# Prototype/throwaway hosts only; never on a shared host.
HOTLAB_ALLOW_DEV_CREDENTIALS=0
# Expected topology. verify.sh asserts these exact QEMU counts by VM-name prefix
# (switch*, control*, server*). Minimal 2-fabric proof: 4 / 1 / 2.
HOTLAB_EXPECT_SWITCHES=REPLACE_ME
HOTLAB_EXPECT_CONTROLS=REPLACE_ME
HOTLAB_EXPECT_SERVERS=REPLACE_ME
# Switch/control health probe, run as the service user in the VLAB dir. Must exit 0 ONLY when
# the fabric is healthy (e.g. all switch agents registered with the control node). Example shape
# (U, flags unverified for 0.43.1):  hhfab vlab ssh -b control-1 -- 'kubectl get agents'
HOTLAB_VLAB_HEALTH_CMD=REPLACE_ME

# ---- REQUIRED only by persistence-test.sh ------------------------------------
# Run as `CMD <switch-vm-name>`; exit 0 only if that switch runs its installed NOS (not ONIE).
# HOTLAB_SWITCH_NOS_CMD=

# ---- REQUIRED only when using cloud-init/user-data.yaml (git-based delivery) -
# HOTLAB_BOOTSTRAP_REPO=https://github.com/afewell-hh/hh-learn.git
# HOTLAB_BOOTSTRAP_REF=<40-hex commit SHA>

# ---- OPTIONAL (defaults shown) ----------------------------------------------
# Address the k3d load balancer publishes ops ports on. 127.0.0.1 = reach via SSH
# tunnel / the workspace tier (#505). 0.0.0.0 only if the provision layer firewalls.
HOTLAB_BIND_ADDRESS=127.0.0.1
HOTLAB_STATE_DIR=/var/lib/hotlab
HOTLAB_VLAB_USER=hotlab
HOTLAB_VLAB_DIR=/var/lib/hotlab/vlab
HOTLAB_K3D_CLUSTER=hotlab-mgmt
# Pinned hhfab (0.43.1 pins are in lib/pins.sh). 0.50.4 is NOT pinned here.
HOTLAB_HHFAB_VERSION=0.43.1
# UNVERIFIED flag sets, passed verbatim to hhfab. Characters limited to [A-Za-z0-9_=,.:/@+ -].
# `-f`/`--recreate` in UP_ARGS and `-f`/`--force` in INIT_ARGS are rejected (they destroy disks/state).
HOTLAB_VLAB_GEN_ARGS=""
HOTLAB_VLAB_UP_ARGS="--kill-stale"
# Bounded readiness wait used by verify.sh, and the stability window after first ready.
HOTLAB_READY_TIMEOUT=1800
HOTLAB_READY_STABLE=30
# Stage toggles, so the ops stack and VLAB can be exercised independently.
HOTLAB_ENABLE_OPS=1
HOTLAB_ENABLE_VLAB=1
# Optional exact Docker apt version string (apt-cache madison docker.io). Empty = distro current, recorded not pinned.
HOTLAB_DOCKER_APT_VERSION=
