# Copy to ./proof.env on the guest (shell syntax, no spaces around '=').
# Every value that depends on the wiring diagram (PR #509, lab-wiring/ai-factory-26.05/)
# must be filled from that diagram, not guessed. The scripts do not parse the diagram.

PROOF_OUT=/var/lib/hotlab/proof-501/out     # evidence.jsonl + raw/ land here
PROOF_DIR=/var/lib/hotlab/proof-501         # baseline/ and multifabric/ working dirs
WIRING_SRC=                                 # path to the lab-wiring/ai-factory-26.05 checkout (U: layout)

# hhfab 26.05 (see README 'Obtaining 26.05'): NO default. Provide URL + sha256 of the archive.
HHFAB_2605_URL=
HHFAB_2605_ARCHIVE_SHA256=
HHFAB_2605_MEMBER=hhfab                      # path of the binary inside the archive (U)
HHFAB_INIT_ARGS="--dev"                      # U for 26.05; compare with `hhfab init --help` in raw/
HHFAB_BASELINE_GEN_ARGS=""                   # U; baseline single-fabric default topology
HHFAB_UP_ARGS=""                             # U (e.g. --kill-stale)
HHFAB_WIRING_FLAG="--wiring"                 # U: flag that feeds a wiring dir/file to `hhfab init`

# Optional: checkouts of githedgehog/fabric and fabricator at the tag matching the hhfab build,
# used only to LOCATE (grep) the file:line of a validation error. Never modified.
FABRIC_SRC=
FABRICATOR_SRC=

# Reaching VMs (templates; %NODE% is substituted). Verify against raw/preflight-ssh-help.txt.
NODE_SSH_PREFIX="hhfab vlab ssh -n %NODE% --"
KCTL_CMD="sudo k3s kubectl"
CONTROL_NODE=control-1

# Topology under test (from the wiring diagram). Switch names below are placeholders.
PROOF_FABRICS="frontend backend"
SWITCHES_frontend="leaf-01 spine-01"
SWITCHES_backend="leaf-02 spine-02"
MULTI_SERVER=server-01                       # the server with Connections into BOTH Fabrics
PEER_SERVER=server-02
EXPECTED_MULTI_SERVER_NICS=                  # number of Connections referencing MULTI_SERVER, from the diagram
LLDP_MIN_NEIGHBORS=1                         # per switch

# Probes. IPs/VPCAttachments must already be configured (by the wiring/VPC objects or by hand).
POS_SRC_NODE=server-01
POS_SRC_IFACE=                               # optional: ping -I <iface>
POS_DST_NODE=server-02
POS_DST_IP=
NEG_SRC_NODE=server-01
NEG_SRC_IFACE=
NEG_DST_NODE=server-02
NEG_DST_IP=                                  # address that SHOULD be unreachable by design
NEG_CTRL_DST_IP=                             # address reachable from NEG_SRC over the same path; proves the source is healthy

# Restart tests
RESTART_SWITCH=leaf-01
RESTART_TIMEOUT_S=900
CONVERGE_TIMEOUT_S=900
VLAB_UNIT=hotlab-vlab.service                # only for the optional `vlab-restart` step
